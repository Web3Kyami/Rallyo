# Telegram
TELEGRAM_BOT_TOKEN=
# Use polling for local tests (no public HTTPS endpoint required).
TELEGRAM_TRANSPORT=polling
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=

# App
APP_BASE_URL=
SESSION_SECRET=
# Private Operator Console access. Keep this value out of Git and use a long random secret.
OPERATOR_ACCESS_KEY=
RALLYO_PORT=3000

# LLM provider (used for offline/batch question generation only)
LLM_API_KEY=
LLM_MODEL=

# Nimiq reward wallet / payout configuration
# Never put a real private key in this committed example.
NIMIQ_NETWORK=
NIMIQ_REWARD_WALLET_ADDRESS=
NIMIQ_REWARD_WALLET_PRIVATE_KEY=
